# Copy to .env.local (./scripts/setup.sh does this for you).
# Backend base URL (no trailing slash). Must match the backend PORT, and this
# page's origin must be listed in the backend's FRONTEND_URL.
VITE_BACKEND_URL=http://localhost:5000

# "true"  = the Payments tab runs on built-in fake data (UI-only work, no backend needed).
# "false" = the Payments tab talks to the real backend; paste a role token from the
#           backend .env into the Payments tab to load data.
# The Missions and Main Wallet tabs always use the real backend.
VITE_USE_MOCK=false
