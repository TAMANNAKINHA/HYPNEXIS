PORT=5000
# Browser origin(s) allowed to call this API and the Socket.IO server. Comma-separate several.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Requests per 15 minutes per IP on /api/. Raise for heavy local demo use.
RATE_LIMIT_MAX=100

# Set distinct role tokens and actor labels. Never commit actual secrets.
PAYMENT_READER_TOKEN=replace-with-reader-secret
PAYMENT_OPERATOR_TOKEN=replace-with-operator-secret
PAYMENT_APPROVER_TOKEN=replace-with-approver-secret
PAYMENT_EXECUTOR_TOKEN=replace-with-executor-secret
PAYMENT_ADMIN_TOKEN=replace-with-admin-secret
READER_ACTOR=payment-reader
OPERATOR_ACTOR=payment-operator
APPROVER_ACTOR=payment-approver
EXECUTOR_ACTOR=payment-executor
ADMIN_ACTOR=payment-admin
PAYMENT_DB_PATH=./data/payments.json

# Real chain submission is not implemented; keep demo mode enabled.
EXECUTION_MODE=demo
USE_REAL_CONTRACT=false
RPC_URL=
CHAIN_ID=1337
CONTRACT_ADDRESS=
# Reserved for a future reviewed adapter. Current backend does not support
# real execution against IMissionWallet; configuring an ABI cannot enable it.
CONTRACT_ABI=
CONTRACT_EXECUTE_METHOD=
CONTRACT_EXECUTION_EVENT=
PRIVATE_KEY=
PAYMENT_DECIMALS=18
CONFIRMATIONS=1
RECIPIENT_ALLOWLIST=
# JSON object mapping mission IDs to arrays of approved recipient addresses.
MISSION_RECIPIENTS_JSON=
SIMULATED_FEE_RATE=
