# ---------------------------------------------------------------------------
# AEGIS backend configuration. Copy to .env (scripts/setup.sh does this for you
# and generates the five PAYMENT_*_TOKEN secrets). Never commit .env.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=5000
# Must match the frontend dev server origin (CORS).
FRONTEND_URL=http://localhost:5173

# --- Payment API credentials -----------------------------------------------
# Each token must be >= 32 characters and must NOT start with "replace-with-"
# (the backend treats those as unset and answers 401). Generate with:
#   node scripts/gen-env.cjs          (fills in missing/placeholder tokens)
#   node scripts/gen-env.cjs --force  (rotates all five)
PAYMENT_READER_TOKEN=replace-with-reader-secret
PAYMENT_OPERATOR_TOKEN=replace-with-operator-secret
PAYMENT_APPROVER_TOKEN=replace-with-approver-secret
PAYMENT_EXECUTOR_TOKEN=replace-with-executor-secret
PAYMENT_ADMIN_TOKEN=replace-with-admin-secret
READER_ACTOR=payment-reader
OPERATOR_ACTOR=payment-operator
APPROVER_ACTOR=payment-approver
EXECUTOR_ACTOR=payment-executor
ADMIN_ACTOR=payment-admin
PAYMENT_DB_PATH=./data/payments.json

# --- Execution mode ---------------------------------------------------------
# demo = payments can be created/approved/simulated but NOT executed.
# real = execute against the contract below. scripts/deploy-local.ts switches
#        this to real and fills the block below for the local Hardhat chain.
EXECUTION_MODE=demo

# --- Chain / contract (filled by scripts/deploy-local.ts for local dev) ------
RPC_URL=
CHAIN_ID=1337
CONTRACT_ADDRESS=
# JSON array (human-readable ABI strings are fine). The adapter requires
#   execute(address recipient, uint256 amount)
#   event PaymentExecuted(address indexed recipient, uint256 amount)
CONTRACT_ABI=
CONTRACT_EXECUTE_METHOD=execute
CONTRACT_EXECUTION_EVENT=PaymentExecuted
# LOCAL CHAIN ONLY: Hardhat's public test key is written here by deploy-local.
# For any testnet use a throwaway key funded from a faucet. Never a real key.
PRIVATE_KEY=
PAYMENT_DECIMALS=18
CONFIRMATIONS=1

# --- Recipient policy (required when EXECUTION_MODE=real) --------------------
# Comma-separated global allowlist.
RECIPIENT_ALLOWLIST=
# JSON object: mission ID -> approved addresses. "*" is only honoured after the
# optional patch in patches/0001-mission-recipient-wildcard.patch is applied.
MISSION_RECIPIENTS_JSON=
SIMULATED_FEE_RATE=

# --- Hardhat / testnet (optional) -------------------------------------------
# LOCAL_RPC_URL=http://127.0.0.1:8545
# HARDHAT_HOST=127.0.0.1
# HARDHAT_PORT=8545
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# BASESCAN_API_KEY=
# REPORT_GAS=1

# --- Legacy mission demo path (src/services/blockchainService.ts) -----------
# Still a mock even when true; see KNOWN_BUGS.md.
USE_REAL_CONTRACT=false
